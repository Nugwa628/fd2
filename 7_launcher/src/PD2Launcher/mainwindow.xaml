<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PD2Launcherv2.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PD2Launcherv2.CustomControl" Title="Project Diablo 2 Launcher" Height="600" Width="800" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" xmlns:pd2launcherv2="clr-namespace:PD2Launcherv2">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Grid>
    <Image Source="pack://application:,,,/Resources/Images/bg2.jpg" Stretch="Fill" MouseLeftButtonDown="BackgroundImage_MouseLeftButtonDown" />
    <Image xmlns:gif="http://wpfanimatedgif.codeplex.com" xmlns:wpfanimatedgif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif" wpfanimatedgif:ImageBehavior.AnimatedSource="pack://application:,,,/Resources/Images/logo.gif" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,5,0" MouseLeftButtonDown="BackgroundImage_MouseLeftButtonDown" />
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,175,0,0">
        <TextBlock Margin="5" FontSize="20">
          <Hyperlink NavigateUri="https://www.projectdiablo2.com/market" RequestNavigate="Hyperlink_RequestNavigate">
            <TextBlock Text="Home" Style="{StaticResource HyperlinkMouseOverStyle}" FontFamily="{StaticResource BlizzMedium}" />
          </Hyperlink>
        </TextBlock>
        <TextBlock Text="•" Margin="5" FontSize="20" Foreground="{StaticResource GoldBrush}" />
        <TextBlock Margin="5" FontSize="20">
          <Hyperlink NavigateUri="https://www.projectdiablo2.com/market" RequestNavigate="Hyperlink_RequestNavigate">
            <TextBlock Text="Trade" Style="{StaticResource HyperlinkMouseOverStyle}" FontFamily="{StaticResource BlizzMedium}" />
          </Hyperlink>
        </TextBlock>
        <TextBlock Text="•" Margin="5" FontSize="20" Foreground="{StaticResource GoldBrush}" />
        <TextBlock Margin="5" FontSize="20">
          <Hyperlink NavigateUri="https://www.reddit.com/r/ProjectDiablo2/" RequestNavigate="Hyperlink_RequestNavigate">
            <TextBlock Text="Reddit" Style="{StaticResource HyperlinkMouseOverStyle}" FontFamily="{StaticResource BlizzMedium}" />
          </Hyperlink>
        </TextBlock>
        <TextBlock Text="•" Margin="5" FontSize="20" Foreground="{StaticResource GoldBrush}" />
        <TextBlock Margin="5" FontSize="20">
          <Hyperlink NavigateUri="https://twitter.com/projectdiablo2" RequestNavigate="Hyperlink_RequestNavigate">
            <TextBlock Text="Twitter" Style="{StaticResource HyperlinkMouseOverStyle}" FontFamily="{StaticResource BlizzMedium}" />
          </Hyperlink>
        </TextBlock>
        <TextBlock Text="•" Margin="5" FontSize="20" Foreground="{StaticResource GoldBrush}" />
        <TextBlock Margin="5" FontSize="20">
          <Hyperlink NavigateUri="https://discord.com/invite/RgX4MWu" RequestNavigate="Hyperlink_RequestNavigate">
            <TextBlock Text="Discord" Style="{StaticResource HyperlinkMouseOverStyle}" FontFamily="{StaticResource BlizzMedium}" />
          </Hyperlink>
        </TextBlock>
        <TextBlock Text="•" Margin="5" FontSize="20" Foreground="{StaticResource GoldBrush}" />
        <TextBlock Margin="5" FontSize="20">
          <Hyperlink NavigateUri="https://wiki.projectdiablo2.com/wiki/Main_Page" RequestNavigate="Hyperlink_RequestNavigate">
            <TextBlock Text="Wiki" Style="{StaticResource HyperlinkMouseOverStyle}" FontFamily="{StaticResource BlizzMedium}" />
          </Hyperlink>
        </TextBlock>
      </StackPanel>
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">
        <ListBox Name="NewsListBox" Padding="0" ItemContainerStyle="{StaticResource CustomNewsListBoxItemStyle}" Background="{StaticResource DarkGray}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="2" FontFamily="{StaticResource BlizzMedium}" FontSize="14" Opacity=".8" Width="700" Height="240" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" ScrollViewer.CanContentScroll="False" ItemsSource="{Binding NewsItems}" FocusVisualStyle="{x:Null}" SelectionChanged="NewsListBox_SelectionChanged">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="5,-5,0,0" FontSize="15" Foreground="{StaticResource GoldLighterBrush}" Text="{Binding Title}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-6,5,0" Foreground="{StaticResource GoldDarkerBrush}" Text="{Binding Date}" />
                <TextBlock TextWrapping="Wrap" Grid.ColumnSpan="2" Margin="5,20,0,10" Text="{Binding Summary}" />
                <Border BorderBrush="{StaticResource GoldBrush}" BorderThickness="0,0,0,1" Grid.ColumnSpan="2" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomVerticalScrollBar}" />
            </ResourceDictionary>
          </FrameworkElement.Resources>
        </ListBox>
      </StackPanel>
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
      <local:CustomImageButton x:Name="MinimizeButton" Click="MinimizeButton_Click" Width="25" Height="25" Margin="0,10,-1,0" NormalImageSource="pack://application:,,,/Resources/Images/minimize.jpg" PressedImageSource="pack://application:,,,/Resources/Images/minimize_pressed.jpg" />
      <local:CustomImageButton x:Name="CloseButton" Click="CloseButton_Click" Width="25" Height="25" Margin="5,10,0,0" NormalImageSource="pack://application:,,,/Resources/Images/close.jpg" PressedImageSource="pack://application:,,,/Resources/Images/close_pressed.jpg" />
    </StackPanel>
    <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-1,0,0,10" Width="700">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" Width="270" Margin="0,0,0,0">
        <Grid Margin="0,-1,0,0" Width="270" Height="35">
          <local:CustomImageButton x:Name="PlayButton" Click="PlayButton_Click" Width="270" Height="35" NormalImageSource="pack://application:,,,/Resources/Images/play.jpg" PressedImageSource="pack://application:,,,/Resources/Images/play_pressed.jpg" />
          <ProgressBar Name="DownloadProgressBar" Width="270" Height="35" HorizontalAlignment="Center" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ImageFillProgressBarStyle}" Visibility="Collapsed" />
        </Grid>
        <Grid Width="270" Height="65" Margin="0,5,0,0">
          <local:CustomImageButton x:Name="LootButton" Width="270" Height="28" VerticalAlignment="Bottom" Margin="0,-15,0,0" Panel.ZIndex="0" NormalImageSource="pack://application:,,,/Resources/Images/loot.jpg" PressedImageSource="pack://application:,,,/Resources/Images/loot_pressed.jpg" Command="{Binding OpenLootCommand}" />
          <local:CustomImageButton x:Name="OptionsButton" Width="270" Height="35" VerticalAlignment="Top" Margin="0,3,0,0" Panel.ZIndex="1" NormalImageSource="pack://application:,,,/Resources/Images/options.jpg" PressedImageSource="pack://application:,,,/Resources/Images/options_pressed.jpg" Command="{Binding OpenOptionsCommand}" />
        </Grid>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" Width="270" Margin="0,0,0,0">
        <local:CustomImageButton x:Name="DonateButton" Click="DonateButton_Click" Width="270" Height="35" Margin="0,0,-2,1" NormalImageSource="pack://application:,,,/Resources/Images/donate.jpg" PressedImageSource="pack://application:,,,/Resources/Images/donate_pressed.jpg" />
        <StackPanel Width="270" Height="40" Margin="0,5,0,0">
          <Panel.Background>
            <SolidColorBrush Color="Black" Opacity="0.3" />
          </Panel.Background>
          <TextBlock Text="Thanks for your support, we couldn't keep the servers around without this community!" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource GoldLighterBrush}" FontFamily="{StaticResource BlizzLight}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
          <Image Name="BetaNotification" Width="65" Height="20" Margin="0,0,10,2.5" Stretch="Fill" Source="pack://application:,,,/Resources/Images/btn_beta.jpg" Visibility="{Binding BetaVisibility}" />
          <local:CustomImageButton x:Name="AboutButton" Width="25" Height="25" Margin="0,-1,0,0" NormalImageSource="pack://application:,,,/Resources/Images/btn_switch.jpg" PressedImageSource="pack://application:,,,/Resources/Images/btn_switch_pressed.jpg" Command="{Binding OpenAboutCommand}" />
          <Image Width="50" Height="15" Margin="5" Source="pack://application:,,,/Resources/Images/custom_notif.jpg" Visibility="{Binding CustomVisibility}" />
        </StackPanel>
        <TextBlock Text="v 2.14.3" HorizontalAlignment="Right" Margin="0,0,0,0" Foreground="{StaticResource SoftWhite}" FontFamily="{StaticResource BlizzMedium}" />
      </StackPanel>
    </Grid>
    <Image Name="UpdatesNotification" Focusable="False" Source="pack://application:,,,/Resources/Images/btn_no_updates3.jpg" Stretch="Fill" Height="20" Width="100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="50,5,0,135" Visibility="{Binding UpdatesNotificationVisibility}" />
    <Rectangle Name="Overlay" Fill="#AA000000" Visibility="Collapsed" />
    <Frame Name="MainFrame" NavigationUIVisibility="Hidden" />
  </Grid>
</Window>