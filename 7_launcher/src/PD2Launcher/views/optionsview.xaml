<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="PD2Launcherv2.Views.OptionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Width="750" Height="550" Title="OptionsView" xmlns:views="clr-namespace:PD2Launcherv2.Views;assembly=PD2Launcher" DataContext="{Binding OptionsViewModel, Source={StaticResource ViewModelLocator}}">
  <Grid>
    <Image Source="pack://application:,,,/Resources/Images/bg_plain.jpg" Stretch="Fill" />
    <Button Name="CloseButton" Style="{StaticResource CloseButtonStyle}" FontFamily="{StaticResource BlizzHeavy}" FontSize="25" Content="X" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Panel.ZIndex="99" Command="{Binding CloseCommand}" />
    <ScrollViewer Margin="20" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
      <StackPanel>
        <TextBlock Text="Options" FontSize="25" Margin="0,20,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource BlizzHeavy}" />
        <TextBlock Text="Windows Permissions" HorizontalAlignment="Center" FontSize="12" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldLighterBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Name="SetWindowsPermissions" Content="Set" Style="{StaticResource CustomColorChangeButton}" Width="75" Height="25" FontSize="12" Margin="5" Foreground="#FF000000" FontFamily="{StaticResource BlizzLight}" Command="{Binding SetWindowsPermissionsCommand}">
            <FrameworkElement.ToolTip>
              <ToolTip>
                <TextBlock Text="If you're encountering windows permissions errors, try setting Windows permissions." />
              </ToolTip>
            </FrameworkElement.ToolTip>
          </Button>
          <Button Name="RemoveWindowsPermissions" Content="Remove" Style="{StaticResource CustomColorChangeButton}" Width="75" Height="25" Margin="5" FontSize="12" Foreground="#FF000000" FontFamily="{StaticResource BlizzLight}" Command="{Binding RemoveWindowsPermissionsCommand}">
            <FrameworkElement.ToolTip>
              <ToolTip>
                <TextBlock Text="Remove Windows permissions if no longer needed." />
              </ToolTip>
            </FrameworkElement.ToolTip>
          </Button>
        </StackPanel>
        <GroupBox Header="Graphics" Margin="10,0,0,0" FontWeight="Bold" BorderThickness="0" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="14">
          <StackPanel>
            <RadioButton Name="d2gl" Content="3dfx" GroupName="renderer" Style="{StaticResource CustomRadioButtonStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="14" HorizontalAlignment="Left" Margin="10,10,0,0" IsChecked="{Binding IsDdrawSelected, Converter={StaticResource InverseBool}}" />
            <RadioButton Name="ddraw" Content="ddraw" GroupName="renderer" Style="{StaticResource CustomRadioButtonStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="14" HorizontalAlignment="Left" Margin="10,10,0,0" IsChecked="{Binding IsDdrawSelected}" />
            <TextBlock Text="Note: You can use CTRL+O in-game to edit video settings" FontSize="12" FontStyle="Italic" Margin="10,0,10,10" Foreground="{StaticResource GoldDarkerBrush}" />
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Sound" Margin="10,-5,0,0" FontWeight="Bold" BorderThickness="0" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldLighterBrush}" FontSize="14">
          <CheckBox Name="sndbkg" Content="Sound in Background (-sndbkg)" Style="{StaticResource CustomCheckBoxStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding SndBkg, Mode=TwoWay}" />
        </GroupBox>
        <GroupBox Header="Other" Margin="10,0,0,0" FontWeight="Bold" BorderThickness="0" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldLighterBrush}" FontSize="14">
          <StackPanel>
            <CheckBox Name="SkipToBNet" Content="Skip To BattleNet (-skiptobnet)" Style="{StaticResource CustomCheckBoxStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding SkipToBnet, Mode=TwoWay}" />
            <CheckBox Name="DisableAutoUpdate" Content="Disable Updates" Style="{StaticResource CustomCheckBoxStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding AutoUpdate, Mode=TwoWay}" />
            <TextBlock Text="Checking this will stop your game from updating when you select the play button" FontSize="12" FontStyle="Italic" Margin="10,0,10,10" Foreground="{StaticResource GoldDarkerBrush}" />
          </StackPanel>
        </GroupBox>
        <StackPanel Margin="10,-10,0,0" Visibility="{Binding DDrawControlsVisible}">
          <TextBlock Text="Mode" FontFamily="{StaticResource BlizzMedium}" Style="{StaticResource OptionsTextBlockHeaderStyle}" Margin="0,0,0,5" />
          <ComboBox Name="Mode" SelectedValuePath="ActualValue" DisplayMemberPath="DisplayValue" Style="{StaticResource CustomComboBoxStyle}" ItemsSource="{Binding OptionsModePicker}" SelectedValue="{Binding SelectedMode, Mode=TwoWay}" />
          <StackPanel Margin="0,0,0,0" Visibility="{Binding NonFullScreenVisibility}">
            <TextBlock Text="Width" FontFamily="{StaticResource BlizzMedium}" Style="{StaticResource OptionsTextBlockHeaderStyle}" FontSize="14" Margin="0,-15,0,0" />
            <TextBox Name="Width" Margin="0,5,0,10" Style="{StaticResource CustomTextBoxStyle}" Text="{Binding Width, Mode=TwoWay, Converter={StaticResource StringToIntConverter}, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Height" FontFamily="{StaticResource BlizzMedium}" Style="{StaticResource OptionsTextBlockHeaderStyle}" FontSize="14" Margin="0,0,0,0" />
            <TextBox Name="Height" Margin="0,5,0,10" Style="{StaticResource CustomTextBoxStyle}" Text="{Binding Height, Converter={StaticResource StringToIntConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="0 = default" Margin="0,-10,0,0" FontSize="12" Foreground="{StaticResource GoldDarkerBrush}" FontFamily="{StaticResource BlizzMedium}" Style="{StaticResource OptionsTextBlockHeaderStyle}" />
            <TextBlock Text="Vertical" FontFamily="{StaticResource BlizzMedium}" Style="{StaticResource OptionsTextBlockHeaderStyle}" FontSize="14" Margin="0,10,0,0" />
            <TextBox Name="ddrawPosX" Margin="0,5,0,10" Style="{StaticResource CustomTextBoxStyle}" Text="{Binding DdrawPosX, Converter={StaticResource StringToIntConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Horizontal" FontFamily="{StaticResource BlizzMedium}" Style="{StaticResource OptionsTextBlockHeaderStyle}" FontSize="14" Margin="0,0,0,0" />
            <TextBox Name="ddrawPosY" Margin="0,5,0,10" Style="{StaticResource CustomTextBoxStyle}" Text="{Binding DdrawPosY, Converter={StaticResource StringToIntConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="-320000 = Center To Screen" Margin="0,-10,0,15" FontSize="12" Foreground="{StaticResource GoldDarkerBrush}" FontFamily="{StaticResource BlizzMedium}" Style="{StaticResource OptionsTextBlockHeaderStyle}" />
          </StackPanel>
          <CheckBox Name="maintasCheckBox" Content="Maintain Aspect Ratio" Style="{StaticResource CustomCheckBoxStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding MaintainAspectRatio, Mode=TwoWay}" />
          <CheckBox Name="boxingCheckBox" Content="Windowboxing / Integer Scaling" Style="{StaticResource CustomCheckBoxStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding Windowboxing, Mode=TwoWay}" />
          <CheckBox Name="vsyncCheckBox" Content="Vertical Sync" Style="{StaticResource CustomCheckBoxStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding VerticalSync, Mode=TwoWay}" />
          <TextBlock Text="Enable this if you get tearing." FontFamily="{StaticResource BlizzMedium}" Margin="50,0,0,-10" Foreground="{StaticResource GoldDarkerBrush}" FontSize="10" />
          <CheckBox Name="adjmouseCheckBox" Content="Automatic Mouse Sensitivity" Style="{StaticResource CustomCheckBoxStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding AutomaticMouseSensitivity, Mode=TwoWay}" />
          <TextBlock Text="Only works if full screen is enabled" FontFamily="{StaticResource BlizzMedium}" Margin="50,0,0,-10" Foreground="{StaticResource GoldDarkerBrush}" FontSize="10" />
          <CheckBox Name="devmodeCheckBox" Content="Unlock cursor" Style="{StaticResource CustomCheckBoxStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding UnlockCursor, Mode=TwoWay}" />
          <CheckBox Name="borderCheckBox" Content="Show Window Borders" Style="{StaticResource CustomCheckBoxStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding ShowWindowBorders, Mode=TwoWay}" />
          <CheckBox Name="resizeableCheckBox" Content="Resizable window" Style="{StaticResource CustomCheckBoxStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding ResizableWindow, Mode=TwoWay}" />
          <TextBlock Text="Default DDraw Settings" HorizontalAlignment="Right" FontSize="14" Height="50" Width="150" TextWrapping="Wrap" Foreground="{StaticResource SoftWhite}" FontFamily="{StaticResource BlizzMedium}" Style="{StaticResource OptionsSubText}" Margin="-15" />
          <Button Content="Default DDraw" FontSize="14" HorizontalAlignment="Right" FontFamily="{StaticResource BlizzMedium}" Style="{StaticResource CustomColorChangeButton}" Margin="0" Command="{Binding RestoreDefaultsCommand}" />
          <Button Name="ShowAdvancedOptionsButton" Content="Show Advanced Options" FontFamily="{StaticResource BlizzHeavy}" FontSize="20" Style="{StaticResource TransparentButtonWithHighlight}" Command="{Binding ToggleAdvancedOptionsCommand}" />
        </StackPanel>
        <StackPanel Visibility="{Binding AdvancedOptionsVisibility}">
          <CheckBox Name="noActivateAppCheckBox" Content="Hide alt+tab messages" Style="{StaticResource CustomCheckBoxStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding NoActivateApp, Mode=TwoWay}" />
          <CheckBox Name="handleMouseCheckBox" Content="DDraw Handle Mouse" Style="{StaticResource CustomCheckBoxStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding HandleMouse, Mode=TwoWay}" />
          <TextBlock Text="Uncheck this if cursor is disappearing." FontFamily="{StaticResource BlizzMedium}" Margin="50,0,0,-10" Foreground="{StaticResource GoldDarkerBrush}" FontSize="10" />
          <CheckBox Name="nonExclusiveCheckBox" Content="Disable fullscreen-exclusive mode" Style="{StaticResource CustomCheckBoxStyle}" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding NonExclusive, Mode=TwoWay}" />
          <TextBlock Text="Use if some GUI elements are invisible." FontFamily="{StaticResource BlizzMedium}" Margin="50,0,0,-10" Foreground="{StaticResource GoldDarkerBrush}" FontSize="10" />
          <TextBlock Text="Rendering rate (Max FPS)" Style="{StaticResource OptionsTextBlockHeaderStyle}" FontFamily="{StaticResource BlizzMedium}" Margin="0,15,0,0" />
          <TextBlock Text="Does not have an impact on the game speed" Style="{StaticResource OptionsSubText}" FontFamily="{StaticResource BlizzMedium}" Margin="50,0,0,-5" Foreground="{StaticResource GoldDarkerBrush}" FontSize="10" />
          <ComboBox Name="maxfpsPicker" SelectedValuePath="ActualValue" DisplayMemberPath="DisplayValue" Style="{StaticResource CustomComboBoxStyle}" Margin="0,10,0,0" ItemsSource="{Binding MaxFpsPickerItems}" SelectedValue="{Binding SelectedMaxFps, Mode=TwoWay}" />
          <TextBlock Text="Max game ticks" Style="{StaticResource OptionsTextBlockHeaderStyle}" FontFamily="{StaticResource BlizzMedium}" Margin="0,10,0,0" />
          <TextBlock Text="Fix for flickering (lower = slower)" Style="{StaticResource OptionsSubText}" FontFamily="{StaticResource BlizzMedium}" Margin="50,0,0,-10" Foreground="{StaticResource GoldDarkerBrush}" FontSize="10" />
          <ComboBox Name="maxgameticksPicker" SelectedValuePath="ActualValue" DisplayMemberPath="DisplayValue" Style="{StaticResource CustomComboBoxStyle}" Margin="0,10,0,0" ItemsSource="{Binding MaxGameTicksPickerItems}" SelectedValue="{Binding SelectedMaxGameTicks, Mode=TwoWay}" />
          <TextBlock Text="Save Window Position" Style="{StaticResource OptionsTextBlockHeaderStyle}" FontFamily="{StaticResource BlizzMedium}" Margin="0,10,0,0" />
          <TextBlock Text="Save window position/size" Style="{StaticResource OptionsSubText}" FontFamily="{StaticResource BlizzMedium}" Margin="50,0,0,-10" Foreground="{StaticResource GoldDarkerBrush}" FontSize="10" />
          <ComboBox Name="savesettingsPicker" SelectedValuePath="ActualValue" DisplayMemberPath="DisplayValue" Style="{StaticResource CustomComboBoxStyle}" Margin="0,10,0,0" ItemsSource="{Binding SaveWindowPositionPickerItems}" SelectedValue="{Binding SelectedSaveWindowPosition, Mode=TwoWay}" />
          <TextBlock Text="Renderer" Style="{StaticResource OptionsTextBlockHeaderStyle}" FontFamily="{StaticResource BlizzMedium}" Margin="0,10,0,0" />
          <TextBlock Text="Auto will try OpenGL, Direct3D, finally GDI" Style="{StaticResource OptionsSubText}" FontFamily="{StaticResource BlizzMedium}" Margin="50,0,0,-10" Foreground="{StaticResource GoldDarkerBrush}" FontSize="10" />
          <ComboBox Name="rendererPicker" SelectedValuePath="ActualValue" DisplayMemberPath="DisplayValue" Style="{StaticResource CustomComboBoxStyle}" Margin="0,10,0,0" ItemsSource="{Binding RendererPickerItems}" SelectedValue="{Binding SelectedRenderer, Mode=TwoWay}" />
          <TextBlock Text="Windows API Hooking" Style="{StaticResource OptionsTextBlockHeaderStyle}" FontFamily="{StaticResource BlizzMedium}" Margin="0,10,0,0" />
          <TextBlock Text="Detours can help with problems, requires rendering GDI" Style="{StaticResource OptionsSubText}" FontFamily="{StaticResource BlizzMedium}" Margin="50,0,0,-10" Foreground="{StaticResource GoldDarkerBrush}" FontSize="10" />
          <ComboBox Name="hookPicker" SelectedValuePath="ActualValue" DisplayMemberPath="DisplayValue" Style="{StaticResource CustomComboBoxStyle}" Margin="0,10,0,0" ItemsSource="{Binding HookPickerItems}" SelectedValue="{Binding SelectedHook, Mode=TwoWay}" />
          <TextBlock Text="Force Minimum FPS" Style="{StaticResource OptionsTextBlockHeaderStyle}" FontFamily="{StaticResource BlizzMedium}" Margin="0,10,0,0" />
          <TextBlock Text="Use 5/10 for display issues(menus/loading screens)" Style="{StaticResource OptionsSubText}" FontFamily="{StaticResource BlizzMedium}" Margin="50,0,0,-10" Foreground="{StaticResource GoldDarkerBrush}" FontSize="10" />
          <ComboBox Name="minfpsPicker" SelectedValuePath="ActualValue" DisplayMemberPath="DisplayValue" Style="{StaticResource CustomComboBoxStyle}" Margin="0,10,0,0" ItemsSource="{Binding MinFpsPickerItems}" SelectedValue="{Binding SelectedMinFps, Mode=TwoWay}" />
          <TextBlock Text="Preliminary Shade Support" Style="{StaticResource OptionsTextBlockHeaderStyle}" FontFamily="{StaticResource BlizzMedium}" Margin="0,10,0,0" />
          <TextBlock Text="Requires Renderer OpenGL" Style="{StaticResource OptionsSubText}" FontFamily="{StaticResource BlizzMedium}" Margin="50,0,0,-10" Foreground="{StaticResource GoldDarkerBrush}" FontSize="10" />
          <ComboBox Name="shaderPicker" SelectedValuePath="ActualValue" DisplayMemberPath="DisplayValue" Style="{StaticResource CustomComboBoxStyle}" Margin="0,10,0,0" ItemsSource="{Binding ShaderPickerItems}" SelectedValue="{Binding SelectedShader, Mode=TwoWay}" />
          <CheckBox Name="d3d9linearCheckBox" Content="Enable d3d9linear" FontFamily="{StaticResource BlizzMedium}" Style="{StaticResource CustomCheckBoxStyle}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding EnableD3d9Linear, Mode=TwoWay}" />
          <TextBlock Text="Upscaling filter for the direct3d9 renderer" Style="{StaticResource OptionsSubText}" FontFamily="{StaticResource BlizzMedium}" Margin="50,0,0,-10" Foreground="{StaticResource GoldDarkerBrush}" FontSize="10" />
          <CheckBox Name="singlecpuCheckBox" Content="Force CPU0 affinity" FontFamily="{StaticResource BlizzMedium}" Style="{StaticResource CustomCheckBoxStyle}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="10,10,10,0" IsChecked="{Binding ForceCpu0Affinity, Mode=TwoWay}" />
          <TextBlock Text="Avoids crashes/freezing can affect performance" Style="{StaticResource OptionsSubText}" FontFamily="{StaticResource BlizzMedium}" Margin="50,0,0,-10" Foreground="{StaticResource GoldDarkerBrush}" FontSize="10" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>